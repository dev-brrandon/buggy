# First-live local binding
LEGIT_ASSISTANT_HTTP_PORT=18080
LEGIT_ASSISTANT_DB_NAME=legit_assistant

# Generate unique values. Never commit the real .env.
LEGIT_ASSISTANT_DB_ADMIN_PASSWORD=CHANGE_ME
LEGIT_ASSISTANT_POSTGRES_PASSWORD=CHANGE_ME
LEGIT_ASSISTANT_MIGRATOR_PASSWORD=CHANGE_ME

# Canonical Buggy PRIMARY_OWNER actor UUID. Must match NetworkCore.
LEGIT_ASSISTANT_BUGGY_PRIMARY_OWNER_ACTOR_ID=ebabce45-f565-48f8-8ec6-7d15b9e7b885

# Existing Panel -> Assistant secrets. Leave blank for boot-only acceptance.
LEGIT_ASSISTANT_PANEL_SERVICE_HMAC_KEY_B64=
LEGIT_ASSISTANT_PANEL_CONTEXT_HMAC_KEY_B64=

# Existing NetworkCore -> Assistant ingress secret. Leave blank for boot-only acceptance.
LEGIT_ASSISTANT_NETWORKCORE_HMAC_KEY_B64=

# Assistant -> NetworkCore read-only authority. Cross-host must be HTTPS.
LEGIT_NETWORKCORE_ASSISTANT_AUTHORITY_URL=
LEGIT_ASSISTANT_NETWORKCORE_AUTHORITY_HMAC_KEY_B64=

# OpenAI-compatible inference endpoint. External endpoint requires ALLOW_EXTERNAL=true.
LEGIT_ASSISTANT_INFERENCE_URL=
LEGIT_ASSISTANT_INFERENCE_MODEL=
LEGIT_ASSISTANT_INFERENCE_API_KEY=
LEGIT_ASSISTANT_INFERENCE_ALLOW_EXTERNAL=false
